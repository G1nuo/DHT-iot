# ============ InfluxDB 2.x 初始化参数（docker compose 使用）============
INFLUX_USERNAME=admin
INFLUX_PASSWORD=iot123456
INFLUX_ORG=iothub
INFLUX_BUCKET=sensor

# InfluxDB API Token：首次启动会自动创建同名 token 时使用该值
# 生成方法：openssl rand -base64 48   或   InfluxDB 网页端 Data → API Tokens 复制
INFLUX_TOKEN=请替换为你自己的-InfluxDB-API-Token
